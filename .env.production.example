#--------------------------------------------------------------------
#  TEMPLATE .env UNTUK PRODUKSI (hosting cPanel — domain zulfiqri.site)
#
#  Cara pakai di server (lakukan SEKALI saja):
#    1. Salin file ini menjadi ".env" di root project:
#         cp .env.production.example .env
#    2. Isi kredensial database sesuai cPanel (MySQL Databases).
#    3. Generate kunci enkripsi unik:
#         php spark key:generate
#
#  File ".env" TIDAK ikut Git (di-ignore), jadi aman dari "git clean"
#  dan tidak tertimpa saat deploy berikutnya.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'https://zulfiqri.site/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE (ganti sesuai data dari cPanel > MySQL Databases)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = zulh7811_muslimin
database.default.username = zulh7811_dbuser
database.default.password = GANTI_PASSWORD_DB
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION  (WAJIB di-generate ulang: php spark key:generate)
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = ci_session_muslimin
session.expiration = 7200
