# Normalisasi line ending agar konsisten antara Windows (lokal) & Linux (hosting)
* text=auto

# Skrip shell WAJIB LF (kalau CRLF, bash di server gagal menjalankannya)
*.sh    text eol=lf
spark   text eol=lf

# File batch Windows tetap CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# File biner — jangan diutak-atik
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.ttf   binary
*.woff  binary
*.woff2 binary

# Hasil build & salinan pustaka (rombak tampilan, 2026-10-13): selalu LF persis keluaran alat, karena dibandingkan bita-per-bita
# oleh php spark dev:cek-ui dan npm run vendor (tanpa ini autocrlf Windows mengubahnya jadi CRLF saat pindah cabang).
public/assets/css/admin.css text eol=lf
public/assets/css/publik.css text eol=lf
public/assets/js/vendor/*.js text eol=lf
app/ThirdParty/flowbite-icons/** text eol=lf
public/assets/fonts/**/*.txt text eol=lf
