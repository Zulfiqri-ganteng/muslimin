# Disable directory browsing
Options -Indexes

# ----------------------------------------------------------------------
# Rewrite engine
# ----------------------------------------------------------------------

# Turning on the rewrite engine is necessary for the following rules and features.
# FollowSymLinks must be enabled for this to work.
<IfModule mod_rewrite.c>
	Options +FollowSymlinks
	RewriteEngine On

	# If you installed CodeIgniter in a subfolder, you will need to
	# change the following line to match the subfolder you need.
	# http://httpd.apache.org/docs/current/mod/mod_rewrite.html#rewritebase
	# RewriteBase /

	# Redirect Trailing Slashes...
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_URI} (.+)/$
	RewriteRule ^ %1 [L,R=301]

	# Rewrite "www.example.com -> example.com"
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

	# (Rombak tampilan F5) CSS/JS yang dimuat dengan penanda versi ?v=<waktu ubah berkas> ditandai ASET_BERVERSI
	# → boleh disimpan peramban lama (lihat blok "Cache aset statis" di bawah). Tanpa substitusi, tidak mengalihkan.
	RewriteCond %{QUERY_STRING} (^|&)v=[0-9]+
	RewriteRule \.(css|js)$ - [E=ASET_BERVERSI:1]

	# Checks to see if the user is attempting to access a valid file,
	# such as an image or css document, if this isn't true it sends the
	# request to the front controller, index.php
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

	# Ensure Authorization header is passed along
	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
	# If we don't have mod_rewrite installed, all 404's
	# can be sent to index.php, and everything works as normal.
	ErrorDocument 404 index.php
</IfModule>

# ----------------------------------------------------------------------
# Cache aset statis & kompresi (rombak tampilan F5) — pindah halaman lebih cepat, tanpa data basi.
#  - CSS/JS BERVERSI (?v=… dari layout admin/publik): disimpan peramban 1 tahun. Aman: bila berkas berubah, ?v ikut berubah.
#  - CSS/JS TANPA ?v: selalu diperiksa ulang ke server (no-cache → cukup jawaban 304 bila tidak berubah).
#  - Font (Inter): 1 tahun. Gambar & berkas unggahan TIDAK diatur di sini (foto yang diganti langsung terlihat baru).
#  - Halaman PHP tidak tersentuh (tetap no-store dari CodeIgniter — aman di komputer bersama).
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
	<FilesMatch "\.(css|js)$">
		Header set Cache-Control "public, max-age=31536000, immutable" env=ASET_BERVERSI
		Header set Cache-Control "no-cache" env=!ASET_BERVERSI
	</FilesMatch>
	<FilesMatch "\.(woff2|woff)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
	<IfModule mod_filter.c>
		AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
	</IfModule>
</IfModule>
# Aturan prefetch menu (Speculation Rules, dipasang lewat header oleh layouts/admin.php) — wajib bertipe MIME ini agar dibaca Chrome.
# Log galat PHP buatan cPanel (error_log) tidak boleh dibuka dari internet — dibaca lewat Admin → Log Error Hosting.
<Files "error_log">
	Require all denied
</Files>

<Files "aturan-prefetch.json">
	ForceType application/speculationrules+json
</Files>

# Disable server signature start
ServerSignature Off
# Disable server signature end
